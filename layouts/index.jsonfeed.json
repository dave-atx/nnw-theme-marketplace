{
  "version": "https://jsonfeed.org/version/1.1",
  "title": "NetNewsWire Themes",
  "home_page_url": {{ site.Home.Permalink | jsonify }},
  "feed_url": {{ "feed.json" | absURL | jsonify }},
  "description": "New and updated community themes for NetNewsWire.",
  "user_comment": "Subscribe to this feed in NetNewsWire, then open an entry to preview and install its theme.",
  "language": "en-US",
  "icon": {{ "feed-icon.png" | absURL | jsonify }},
  "favicon": {{ "feed-icon.png" | absURL | jsonify }},
  "items": [
    {{- /* One item per release: each theme's listed release plus the earlier
           releases in its history. An item keeps the id it had while it was the
           listed release, so readers do not see a duplicate once it is superseded. */}}
    {{- $releases := slice }}
    {{- range $theme := hugo.Data.themes.themes }}
      {{- $releases = $releases | append (dict
        "theme" $theme
        "release" $theme.release
        "released_at" $theme.released_at
        "release_notes" $theme.release_notes
        "asset_name" $theme.asset_name
        "asset_url" $theme.asset_url) }}
      {{- range $theme.release_history }}
        {{- $releases = $releases | append (dict
          "theme" $theme
          "release" .release
          "released_at" .released_at
          "release_notes" .release_notes
          "asset_name" .asset_name
          "asset_url" .asset_url) }}
      {{- end }}
    {{- end }}
    {{- range $index, $entry := sort $releases "released_at" "desc" }}
      {{- if $index }},{{ end }}
      {{- $theme := $entry.theme }}
      {{- $description := $theme.description | htmlEscape }}
      {{- $name := $theme.name | htmlEscape }}
      {{- $installURL := printf "install/?theme=%s" ($theme.id | urlquery) | absURL | htmlEscape }}
      {{- $repositoryURL := $theme.repository_url | htmlEscape }}
      {{- /* feedContentModified stamps a change to this template, which alters every
             item's rendered content without changing its release date. Take the later
             of the two so an item is never modified before it was published. */}}
      {{- $modified := $entry.released_at }}
      {{- with site.Params.feedContentModified }}
        {{- if gt (time.AsTime .) (time.AsTime $entry.released_at) }}
          {{- $modified = . }}
        {{- end }}
      {{- end }}
      {{- $image := "" }}
      {{- with $theme.screenshot_url }}
        {{- $image = printf `<p><img src="%s" alt="Preview of %s"></p>` (. | htmlEscape) $name }}
      {{- end }}
      {{- /* Release notes are untrusted Markdown; Goldmark's unsafe mode stays off in
             hugo.toml so raw HTML and dangerous link schemes are dropped. */}}
      {{- $notes := "" }}
      {{- with $entry.release_notes }}
        {{- $notes = $.RenderString (dict "display" "block") . }}
      {{- end }}
      {{- $content := printf `%s<p>%s</p>%s<p><a href="%s">Install %s in NetNewsWire</a> · <a href="%s">View on GitHub</a></p>` $image $description $notes $installURL $name $repositoryURL }}
      {
        "id": {{ $entry.asset_url | jsonify }},
        "url": {{ $theme.repository_url | jsonify }},
        "external_url": {{ $theme.creator_url | jsonify }},
        "title": {{ printf "%s %s" $theme.name $entry.release | jsonify }},
        "summary": {{ $theme.description | jsonify }},
        "content_html": {{ $content | jsonify }},
        "date_published": {{ $entry.released_at | jsonify }},
        "date_modified": {{ $modified | jsonify }},
        {{- with $theme.screenshot_url }}
        "image": {{ . | jsonify }},
        {{- end }}
        "authors": [
          {
            "name": {{ $theme.creator_name | jsonify }},
            "url": {{ $theme.author_github_url | jsonify }}
          }
        ],
        "tags": ["NetNewsWire", "theme"],
        "attachments": [
          {
            "url": {{ $entry.asset_url | jsonify }},
            "mime_type": "application/zip",
            "title": {{ $entry.asset_name | jsonify }}
          }
        ],
        "_netnewswire": {
          "install_url": {{ $installURL | jsonify }}
        }
      }
    {{- end }}
  ]
}
